{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "aws-cli": "allow",
      "brainstorming": "allow",
      "code-review": "allow",
      "commit-code": "allow",
      "create-dockerfile": "allow",
      "create-skill": "allow",
      "create-terraform-helm-upgrade-plan": "allow",
      "dispatching-parallel-agents": "allow",
      "executing-plans": "allow",
      "finishing-a-development-branch": "allow",
      "github-cli": "allow",
      "gitlab-cli": "allow",
      "grafana-cli": "allow",
      "jenkins-cli": "allow",
      "jira-and-confluence-cli": "allow",
      "maintenance-check-aws-eks": "allow",
      "maintenance-create-ticket-on-jira": "allow",
      "prometheus-cli": "allow",
      "receiving-code-review": "allow",
      "requesting-code-review": "allow",
      "slack-cli": "allow",
      "subagent-driven-development": "allow",
      "systematic-debugging": "allow",
      "test-driven-development": "allow",
      "using-git-worktrees": "allow",
      "using-superpowers": "allow",
      "verification-before-completion": "allow",
      "writing-plans": "allow",
      "writing-skills": "allow"
    },
    "bash": {
      "*": "allow",
      "sops *": "deny",
      "* sops *": "deny",
      "age-keygen *": "deny",
      "gsutil cp gs://*": "deny",
      "gcloud *": "deny",
      "kubectl exec *": "deny",
      "kubectl delete *": "deny",
      "rm -rf *": "deny",
      "rm -r /*": "deny",
      "shred *": "deny",
      "mkfs *": "deny",
      "dd if=* of=/dev/*": "deny",
      "reboot": "deny",
      "shutdown *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "passwd": "deny",
      "useradd *": "deny",
      "usermod *": "deny",
      "adduser *": "deny",
      "deluser *": "deny",
      "groupadd *": "deny",
      "groupmod *": "deny",
      "setfacl *": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "doas *": "deny",
      "pkexec *": "deny",
      "curl *|sh": "deny",
      "curl *|bash": "deny",
      "wget *|sh": "deny",
      "wget *|bash": "deny",
      "bash <(curl *": "deny",
      "bash <(wget *": "deny",
      "sh <(curl *": "deny",
      "sh <(wget *": "deny",
      "curl -k *": "deny",
      "wget --no-check-certificate *": "deny",
      "python3 -c *": "deny",
      "python -c *": "deny",
      "base64 -d *": "deny",
      "openssl *": "deny",
      "ssh-copy-id *": "deny",
      "ssh -i *": "deny",
      "scp *": "deny",
      "rsync *root@*": "deny",
      "rsync *sudo*": "deny",
      "mount *": "deny",
      "umount *": "deny",
      "fdisk *": "deny",
      "fstrim *": "deny",
      "parted *": "deny",
      "rvm *": "deny",
      "nixos-rebuild switch *": "deny",
      "nixos-anywhere *": "deny",
      "docker exec *": "deny",
      "docker stop *": "deny",
      "docker rm *": "deny",
      "docker rmi *": "deny",
      "docker system prune *": "deny",
      "podman exec *": "deny",
      "systemctl poweroff": "deny",
      "systemctl reboot *": "deny",
      "systemctl halt *": "deny",
      "killall -9 *": "deny",
      "kill -9 *": "deny",
      "pkill -9 *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "git clean -fd *": "deny",
      "git filter-branch *": "deny",
      "git gc *": "deny",
      "git reflog expire *": "deny",
      "git commit *": "deny",
      "rm -rf /": "deny",
      "rm -rf ~": "deny",
      "mkswap *": "deny",
      "swapon *": "deny",
      "swapoff *": "deny"
    },
    "external_directory": {
      "*": "allow",
      "~/secrets/**": "deny",
      "**/.ssh/**": "deny",
      "**/.gnupg/**": "deny",
      "**/.config/gh/**": "deny",
      "**/.docker/**": "deny",
      "**/.netrc": "deny",
      "**/.kube/**": "deny",
      "**/.config/gcloud/**": "deny",
      "**/.config/opencode/auth.json": "deny"
